<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sardor Website</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            text-align: center;
            padding: 50px;
        }

        .card {
            background: white;
            max-width: 400px;
            margin: auto;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px #bbb;
        }

        h1 {
            color: #222;
        }

        p {
            color: #666;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            transform: scale(1.05);
        }
    </style>
</head>

<body>

    <div class="card">
        <h1>Salom! 👋</h1>

        <p>Bu mening birinchi HTML sahifam.</p>

        <button onclick="salomBer()">
            Bosib ko‘r
        </button>
    </div>

    <script>
        function salomBer() {
            alert("Salom, Sardor! 🚀");
        }
    </script>

</body>
</html>
