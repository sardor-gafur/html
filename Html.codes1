<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TechStore - Online Do‘kon</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f8;
            color: #222;
        }

        /* HEADER */

        header {
            background: #111827;
            color: white;
            padding: 20px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
        }

        .logo span {
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #38bdf8;
        }

        .cart {
            background: #38bdf8;
            color: #111;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        /* HERO */

        .hero {
            min-height: 500px;
            background: linear-gradient(
                135deg,
                #0f172a,
                #1e3a8a
            );

            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 50px 20px;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero h1 {
            font-size: 55px;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #38bdf8;
        }

        .hero p {
            font-size: 20px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .hero button {
            padding: 15px 30px;
            border: none;
            border-radius: 8px;
            background: #38bdf8;
            font-size: 17px;
            cursor: pointer;
            transition: 0.3s;
        }

        .hero button:hover {
            transform: scale(1.05);
            background: white;
        }

        /* CATEGORIES */

        .categories {
            padding: 60px 7%;
            text-align: center;
        }

        .section-title {
            font-size: 35px;
            margin-bottom: 40px;
        }

        .category-box {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(180px, 1fr));

            gap: 20px;
        }

        .category {
            background: white;
            padding: 30px 20px;
            border-radius: 15px;
            box-shadow: 0 5px 20px #ddd;
            transition: 0.3s;
        }

        .category:hover {
            transform: translateY(-8px);
        }

        .category .icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        /* PRODUCTS */

        .products {
            padding: 60px 7%;
            background: #eef2f7;
        }

        .product-grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(230px, 1fr));

            gap: 25px;
        }

        .product {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px #ddd;
            transition: 0.3s;
        }

        .product:hover {
            transform: translateY(-8px);
        }

        .product-image {
            height: 210px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e5e7eb;
            font-size: 90px;
        }

        .product-info {
            padding: 20px;
        }

        .product-info h3 {
            margin-bottom: 10px;
        }

        .description {
            color: #666;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .price {
            color: #2563eb;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .buy-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #111827;
            color: white;
            cursor: pointer;
            font-size: 16px;
            transition: 0.3s;
        }

        .buy-btn:hover {
            background: #2563eb;
        }

        /* ABOUT */

        .about {
            padding: 70px 7%;
            display: flex;
            gap: 50px;
            align-items: center;
            background: white;
        }

        .about-text {
            flex: 1;
        }

        .about-text h2 {
            font-size: 35px;
            margin-bottom: 20px;
        }

        .about-text p {
            color: #555;
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .about-list {
            margin-top: 20px;
        }

        .about-list li {
            list-style: none;
            margin: 12px 0;
        }

        .about-list li::before {
            content: "✓";
            color: #16a34a;
            font-weight: bold;
            margin-right: 10px;
        }

        .about-image {
            flex: 1;
            min-height: 300px;
            background: #dbeafe;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 120px;
        }

        /* REVIEWS */

        .reviews {
            padding: 70px 7%;
            background: #f4f6f8;
            text-align: center;
        }

        .review-grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(250px, 1fr));

            gap: 25px;
        }

        .review {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 15px #ddd;
        }

        .review-avatar {
            font-size: 45px;
            margin-bottom: 10px;
        }

        .stars {
            color: #f59e0b;
            margin: 10px 0;
        }

        .review p {
            color: #666;
            line-height: 1.6;
        }

        /* CONTACT */

        .contact {
            padding: 70px 7%;
            background: #111827;
            color: white;
            text-align: center;
        }

        .contact h2 {
            font-size: 35px;
            margin-bottom: 15px;
        }

        .contact p {
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        form {
            max-width: 600px;
            margin: auto;
        }

        form input,
        form textarea {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            border-radius: 8px;
            outline: none;
        }

        form textarea {
            height: 130px;
            resize: none;
        }

        form button {
            padding: 14px 35px;
            border: none;
            border-radius: 8px;
            background: #38bdf8;
            cursor: pointer;
            font-size: 16px;
        }

        /* FOOTER */

        footer {
            background: #020617;
            color: #94a3b8;
            padding: 30px 7%;
            text-align: center;
        }

        footer .social {
            margin-bottom: 15px;
        }

        footer a {
            color: #38bdf8;
            text-decoration: none;
            margin: 0 10px;
        }

        /* RESPONSIVE */

        @media (max-width: 700px) {

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 7px;
                font-size: 14px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .about {
                flex-direction: column;
            }

            .about-image {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="logo">
            Tech<span>Store</span>
        </div>

        <nav>
            <a href="#home">Bosh sahifa</a>
            <a href="#products">Mahsulotlar</a>
            <a href="#about">Biz haqimizda</a>
            <a href="#contact">Aloqa</a>
        </nav>

        <div class="cart">
            🛒 Savat: <span id="cartCount">0</span>
        </div>

    </header>


    <!-- HERO -->

    <section class="hero" id="home">

        <div class="hero-content">

            <h1>
                Texnologiya olamiga
                <span> xush kelibsiz!</span>
            </h1>

            <p>
                Eng yangi smartfonlar, noutbuklar,
                aksessuarlar va boshqa texnika mahsulotlarini
                bizdan topishingiz mumkin.
            </p>

            <button onclick="scrollToProducts()">
                Mahsulotlarni ko‘rish
            </button>

        </div>

    </section>


    <!-- CATEGORIES -->

    <section class="categories">

        <h2 class="section-title">
            Kategoriyalar
        </h2>

        <div class="category-box">

            <div class="category">
                <div class="icon">📱</div>
                <h3>Smartfonlar</h3>
                <p>Eng yangi telefonlar</p>
            </div>

            <div class="category">
                <div class="icon">💻</div>
                <h3>Noutbuklar</h3>
                <p>Kuchli va zamonaviy</p>
            </div>

            <div class="category">
                <div class="icon">🎧</div>
                <h3>Quloqchinlar</h3>
                <p>Sifatli ovoz</p>
            </div>

            <div class="category">
                <div class="icon">⌚</div>
                <h3>Smart Watch</h3>
                <p>Aqlli soatlar</p>
            </div>

        </div>

    </section>


    <!-- PRODUCTS -->

    <section class="products" id="products">

        <h2 class="section-title">
            Mashhur mahsulotlar
        </h2>

        <div class="product-grid">

            <div class="product">

                <div class="product-image">
                    📱
                </div>

                <div class="product-info">

                    <h3>Smartphone Pro</h3>

                    <p class="description">
                        6.7 dyuymli ekran, kuchli protsessor
                        va yuqori sifatli kamera.
                    </p>

                    <div class="price">
                        5 999 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Smartphone Pro')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    💻
                </div>

                <div class="product-info">

                    <h3>Ultra Laptop</h3>

                    <p class="description">
                        Tezkor ishlash uchun kuchli
                        protsessor va 16GB RAM.
                    </p>

                    <div class="price">
                        8 499 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Ultra Laptop')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    🎧
                </div>

                <div class="product-info">

                    <h3>Wireless Headphones</h3>

                    <p class="description">
                        Simsiz ulanish va kuchli bass
                        bilan zamonaviy quloqchin.
                    </p>

                    <div class="price">
                        799 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Wireless Headphones')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    ⌚
                </div>

                <div class="product-info">

                    <h3>Smart Watch X</h3>

                    <p class="description">
                        Sport, qo‘ng‘iroqlar va kundalik
                        foydalanish uchun aqlli soat.
                    </p>

                    <div class="price">
                        1 299 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Smart Watch X')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    🖥️
                </div>

                <div class="product-info">

                    <h3>Gaming Monitor</h3>

                    <p class="description">
                        144Hz ekran va tezkor javob vaqti.
                        O‘yinchilar uchun ideal.
                    </p>

                    <div class="price">
                        2 499 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Gaming Monitor')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    ⌨️
                </div>

                <div class="product-info">

                    <h3>Gaming Keyboard</h3>

                    <p class="description">
                        RGB yoritgichli mexanik klaviatura.
                    </p>

                    <div class="price">
                        599 000 so‘m
                    </div>

                    <button
                        class="buy-btn"
                        onclick="addToCart('Gaming Keyboard')">
                        Savatga qo‘shish
                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- ABOUT -->

    <section class="about" id="about">

        <div class="about-text">

            <h2>Nega aynan TechStore?</h2>

            <p>
                Biz mijozlarimizga sifatli va zamonaviy
                texnika mahsulotlarini qulay narxlarda
                taqdim etishga harakat qilamiz.
            </p>

            <p>
                Bizning maqsadimiz — texnologiyani har
                bir inson uchun yanada qulay qilish.
            </p>

            <ul class="about-list">

                <li>Sifatli mahsulotlar</li>

                <li>Qulay narxlar</li>

                <li>Tezkor yetkazib berish</li>

                <li>24/7 mijozlar qo‘llab-quvvatlashi</li>

                <li>Kafolat xizmati</li>

            </ul>

        </div>

        <div class="about-image">
            🛍️
        </div>

    </section>


    <!-- REVIEWS -->

    <section class="reviews">

        <h2 class="section-title">
            Mijozlar fikri
        </h2>

        <div class="review-grid">

            <div class="review">

                <div class="review-avatar">
                    👨🏻
                </div>

                <h3>Ali</h3>

                <div class="stars">
                    ★★★★★
                </div>

                <p>
                    Mahsulot juda yaxshi. Yetkazib berish
                    ham tez bo‘ldi. Yana xarid qilaman.
                </p>

            </div>


            <div class="review">

                <div class="review-avatar">
                    👩🏻
                </div>

                <h3>Madina</h3>

                <div class="stars">
                    ★★★★★
                </div>

                <p>
                    Telefonni juda yaxshi narxda oldim.
                    Xizmat ko‘rsatish ham a'lo darajada.
                </p>

            </div>


            <div class="review">

                <div class="review-avatar">
                    👨🏻‍💻
                </div>

                <h3>Jasur</h3>

                <div class="stars">
                    ★★★★☆
                </div>

                <p>
                    Noutbuk sifati juda yaxshi.
                    Saytdan foydalanish ham oson.
                </p>

            </div>

        </div>

    </section>


    <!-- CONTACT -->

    <section class="contact" id="contact">

        <h2>Biz bilan bog‘laning</h2>

        <p>
            Savollaringiz bo‘lsa, quyidagi forma orqali
            bizga xabar yuboring.
        </p>

        <form onsubmit="sendMessage(event)">

            <input
                type="text"
                id="name"
                placeholder="Ismingiz"
                required
            >

            <input
                type="email"
                id="email"
                placeholder="Email manzilingiz"
                required
            >

            <textarea
                id="message"
                placeholder="Xabaringiz..."
                required
            ></textarea>

            <button type="submit">
                Xabar yuborish
            </button>

        </form>

    </section>


    <!-- FOOTER -->

    <footer>

        <div class="social">

            <a href="#">Instagram</a>

            <a href="#">Telegram</a>

            <a href="#">YouTube</a>

        </div>

        <p>
            © 2026 TechStore. Barcha huquqlar himoyalangan.
        </p>

    </footer>


    <!-- JAVASCRIPT -->

    <script>

        let cartCount = 0;

        function addToCart(productName) {

            cartCount++;

            document.getElementById("cartCount")
                .textContent = cartCount;

            alert(
                productName +
                " savatga qo‘shildi! 🛒"
            );
        }


        function scrollToProducts() {

            document
                .getElementById("products")
                .scrollIntoView({
                    behavior: "smooth"
                });
        }


        function sendMessage(event) {

            event.preventDefault();

            let name =
                document.getElementById("name").value;

            alert(
                "Rahmat, " +
                name +
                "! Xabaringiz yuborildi. ✅"
            );

            event.target.reset();
        }

    </script>

</body>
</html>
